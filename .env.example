# Hyperliquid Configuration
NETWORK=mainnet  # mainnet or testnet

# Tracking Configuration
TRACK_ALL_COINS=false  # Set to true to track all available coins
SELECTED_COINS=BTC,ETH,SOL,ARB  # Comma-separated list of coins to track (ignored if TRACK_ALL_COINS=true)
TRACK_ROLE=both  # Options: 'maker', 'taker', or 'both' - which addresses to track from trades

# Database Configuration
# Note: relative to pipeline/fetcher/, the directory the app runs from
DATABASE_PATH=../../data/addresses.db

# Batch Processing
BATCH_SIZE=1000  # Number of addresses to accumulate before batch insert
DEDUP_INTERVAL=60  # Seconds between deduplication runs

# Web Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_PORT=5000
DASHBOARD_HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=logs/tracker.log
